<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Items</title>
</head>
<body>
    <button onclick="window.location.href='/items/<%=categoryId%>/add'" >Add Items</button>
    <div class="itemsInCategory">
        <% for(let i=0;i<rows.length;i++) { %>
            <div>
                <h2><%= rows[i].itemname %></h2>
                <img src="<%= rows[i].imgurl %>" alt="<%=rows[i].description%>">
                <p><%= rows[i].description %></p>
                <p><%= rows[i].quantity %></p>
            </div>
         <% } %> 
    </div>
</body>
</html>