<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories</title>
</head>
<body>
    <div class="category">
        <% for(let i=0;i<rows.length;i++) { %>
            <div>
                <a href="/category/<%=rows[i].id%>"><%= rows[i].categoryname %></a>
            </div>
         <% } %>   
    </div>
    <button onclick="window.location.href='/category/add'" >Add Category</button>
</body>
</html>